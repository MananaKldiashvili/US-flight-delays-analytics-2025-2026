{
  "datasets": [
    {
      "name": "aaeea13e",
      "displayName": "AviationReliability",
      "queryLines": [
        "SELECT * FROM getdata.calculated.AviationReliability\n"
      ],
      "columns": [
        {
          "displayName": "TotalAirports",
          "description": "",
          "expression": "COUNT(DISTINCT AirportCode)"
        }
      ]
    },
    {
      "name": "top_carriers",
      "displayName": "TOP 10 საიმედო ავიაკომპანიები",
      "queryLines": [
        "SELECT\n",
        "  CarrierName,\n",
        "  AVG(DelayRatePct) as avg_delay_rate\n",
        "FROM\n",
        "  getdata.calculated.AviationReliability\n",
        "GROUP BY\n",
        "  CarrierName\n",
        "ORDER BY\n",
        "  avg_delay_rate ASC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "worst_carriers",
      "displayName": "TOP 10 პრობლემური ავიაკომპანიები",
